# secrets / env
.env
.env.*
!.env.example

# runtime state
state/
sandbox/*
usage.json

# but keep the committed corpora (everything else under sandbox/ stays ignored).
# `sandbox/*` ignores sandbox's contents so these subdirs can be re-included;
# a bare `sandbox/` would make re-inclusion impossible.
!sandbox/papers/
!sandbox/corpus/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# os
.DS_Store
